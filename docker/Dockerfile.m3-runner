# M3 pipeline runner — extends the serving image with ffmpeg + opencv
# for local video processing (preprocess, extract_frames).
FROM ogmemory:ogmem-rychkov-local

USER root
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -q opencv-python-headless==4.10.0.84 || \
    pip install --no-cache-dir -q opencv-python-headless

# Bake the NLTK corpora BM25 tokenization needs (retrieval/bm25_index.py
# _ensure_nltk). The lazy runtime download silently fails in offline /
# firewalled containers → every BM25 search returns empty → QA degrades to
# "cannot determine". /usr/local/nltk_data is in nltk.data.path for every
# user, so a root-time download here is found at runtime.
# The verification line fails the build if the corpora did not land.
RUN python3 -c "import nltk; [nltk.download(r, download_dir='/usr/local/nltk_data', quiet=True) for r in ('punkt_tab', 'stopwords')]" && \
    python3 -c "import nltk; nltk.data.find('tokenizers/punkt_tab'); nltk.data.find('corpora/stopwords'); print('nltk corpora baked')"

# Local ASR via faster-whisper (CTranslate2 Whisper, CPU int8). The ASR
# stack defaults to the "large-v3-turbo" model — see
# extraction/operators/builtin/asr_backends.py::FasterWhisperBackend
# (m3/voice_asr.py --model defaults to it). The model (~1.5 GB) is
# downloaded from the HF hub on FIRST USE into HF_HOME; bind-mount that
# path to download once and share across runs:
#   -v /data/hf_cache:/home/ogmem/.cache/huggingface
# Build-time verification: import must work without the model present.
RUN pip install --no-cache-dir -q "faster-whisper>=1.0.0" && \
    python3 -c "from faster_whisper import WhisperModel; print('faster-whisper OK')"

ENV HF_HOME=/home/ogmem/.cache/huggingface
RUN mkdir -p /home/ogmem/.cache/huggingface \
    && chown -R ogmem:ogmem /home/ogmem/.cache

USER ogmem