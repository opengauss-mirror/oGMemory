FROM python:3.11-slim-bookworm AS runtime

# Use USTC Debian mirror for faster downloads in China
RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list 2>/dev/null; \
    true

RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq-dev curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    --timeout 120 \
    flask gunicorn openai psycopg2-binary pyagfs rich requests apscheduler httpx pyyaml jinja2 \
    pydantic python-dotenv json-repair networkx "jsonschema>=4.20.0" rank-bm25 nltk \
    "mcp[cli]==2.0.0" "volcengine-ark-runtime==5.0.54"

# The shared image can include the selected optional vector SDK at build time.
ARG VECTOR_DB_EXTRA=opengauss
RUN case "$VECTOR_DB_EXTRA" in \
      opengauss) ;; \
      milvus) pip install --no-cache-dir \
        -i https://mirrors.aliyun.com/pypi/simple/ \
        --timeout 120 'pymilvus>=2.6.17,<2.7' ;; \
      *) echo "Unsupported VECTOR_DB_EXTRA: $VECTOR_DB_EXTRA" >&2; exit 1 ;; \
    esac

# Copy oGMemory source
COPY core/       /opt/ogmem/core/
COPY retrieval/  /opt/ogmem/retrieval/
COPY extraction/ /opt/ogmem/extraction/
COPY commit/     /opt/ogmem/commit/
COPY index/      /opt/ogmem/index/
COPY providers/  /opt/ogmem/providers/
COPY service/    /opt/ogmem/service/
COPY fs/         /opt/ogmem/fs/
COPY server/     /opt/ogmem/server/
COPY session/    /opt/ogmem/session/
COPY cli/        /opt/ogmem/cli/
COPY scripts/    /opt/ogmem/scripts/
COPY skills/     /opt/ogmem/skills/
# lifecycle/ removed — not present in this workspace
COPY perf/       /opt/ogmem/perf/
COPY scene/      /opt/ogmem/scene/

# Set executable permissions in the existing RUN below so both legacy
# Docker builders and BuildKit can build the shared image.
COPY docker/entrypoint-standalone.sh /opt/entrypoint.sh

# Copy default config (user can override via volume mount)
COPY deploy/ogmemory.example.yaml /etc/ogmem/config.yaml

# Create writable data and config directories for the unprivileged runtime.
RUN mkdir -p /data/ogmem /etc/ogmem && \
    useradd -m ogmem && \
    chown -R ogmem:ogmem /data/ogmem /opt/ogmem /etc/ogmem
RUN chmod -R 755 /opt/ogmem && chmod 755 /opt/entrypoint.sh

# Environment defaults (kept for backward compat; YAML config takes priority)
ENV PYTHONPATH=/opt/ogmem
ENV OGMEM_CONFIG=/etc/ogmem/config.yaml
ENV AGFS_MOUNT_PREFIX=/local/plugin
ENV CONTEXTENGINE_PROVIDER=openai
ENV VECTOR_DB_TYPE=opengauss
ENV INDEX_INTERVAL=15
ENV OG_ACCOUNT_ID=acct-demo
ENV OGMEM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ENV OGMEM_EMBEDDING_MODEL=text-embedding-v2
ENV OGMEM_HTTP_PORT=8090
ENV OGMEM_MCP_ENABLED=true
ENV OGMEM_MCP_HOST=0.0.0.0
ENV OGMEM_MCP_PORT=8091
ENV OGMEM_MCP_PATH=/mcp
ENV OGMEM_MCP_DEFAULT_TOOLSET=read-only
ENV OGMEM_MCP_MAX_SSE_CONNECTIONS=64
ENV OGMEM_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,host.docker.internal

USER ogmem
EXPOSE 8090 8091

ENTRYPOINT ["/opt/entrypoint.sh"]

# Opt-in compatibility stages; BuildKit skips these for the default target.
FROM golang:1.25-bookworm AS agfs-builder
ARG GOPROXY=https://proxy.golang.org,direct
WORKDIR /src/agfs
COPY agfs/ ./
RUN CGO_ENABLED=1 go build -trimpath -ldflags="-w -s" -o /agfs-server ./cmd/server

FROM runtime AS standalone-agfs
COPY --chown=ogmem:ogmem --from=agfs-builder /agfs-server /opt/agfs/agfs-server
COPY --chown=ogmem:ogmem config/agfs/config.reference.yaml /opt/agfs/config.yaml
USER root
RUN mkdir -p /data/agfs && chown -R ogmem:ogmem /data/agfs /opt/agfs
USER ogmem

# Last stage is the default: no dependency on the Go/AGFS stages.
FROM runtime AS standalone-no-agfs
