# 复制为 .env 后填写模型配置；不要提交 .env。
COMPOSE_PROJECT_NAME=ogmemory
DATA_ROOT=./data
PUBLISH_IP=127.0.0.1
OGMEM_HTTP_HOST_PORT=18090
OGMEM_MCP_HOST_PORT=18091
OPENGAUSS_IMAGE=swr.cn-north-4.myhuaweicloud.com/kunpeng-ai/opengauss-distributed:0328
OGMEM_IMAGE=swr.cn-north-4.myhuaweicloud.com/kunpeng-ai/ogmemory:1013
# 模型访问代理，可留空；地址必须能从容器访问。
HTTP_PROXY=
HTTPS_PROXY=
# 追加不经过代理的目标；内部服务绕过项由 Compose 保留。
NO_PROXY=
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
OG_ACCOUNT_ID=ogmemory-account
OG_USER_ID=ogmemory-user
OG_AGENT_ID=ogmemory-api-agent
OGMEM_AFTER_TURN_THRESHOLD=400
OGMEM_MCP_ENABLED=true
OGMEM_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,ogmemory,host.docker.internal
# Docker 默认地址池耗尽时，选择无冲突网段后启用。
# OGMEM_NETWORK_SUBNET=10.203.78.0/24
# COMPOSE_FILE=compose.yaml:deploy/compose/compose.network.yaml
# 已有模型服务在其他 Docker 网络中时，可选加入该网络。
# MODEL_DOCKER_NETWORK=your-model-network
# COMPOSE_FILE=compose.yaml:deploy/compose/compose.network.yaml:deploy/compose/compose.model-network.yaml
