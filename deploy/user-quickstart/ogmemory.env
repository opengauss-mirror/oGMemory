# 实例名称：同一服务器上必须唯一，只使用小写字母、数字和短横线。
export INSTANCE_NAME='alice'

# 宿主机端口：同一服务器上必须唯一。
export OPENGAUSS_HOST_PORT='15432'
export OGMEM_HTTP_HOST_PORT='18090'
export OGMEM_MCP_HOST_PORT='18091'
export OPENCLAW_CE_HOST_PORT='18790'
export OPENCLAW_MCP_HOST_PORT='18791'

# OpenAI 兼容的 LLM 服务。
export LLM_BASE_URL='https://你的LLM服务/v1'
export LLM_MODEL='替换为LLM模型名'
export LLM_API_KEY='替换为LLM服务Key'

# Embedding 服务。Base URL 不要包含具体的 /embeddings 接口。
# 文本 Embedding：OpenAI 兼容协议用 openai，Ark 文本向量接口用 volcengine。
export EMBEDDING_PROVIDER='openai'
export EMBEDDING_BASE_URL='https://你的Embedding服务/v1'
export EMBEDDING_MODEL='替换为Embedding模型名'
export EMBEDDING_API_KEY='替换为Embedding服务Key'
export EMBEDDING_DIMENSION='1024'

# 重新执行脚本默认只重建容器，不删除本地持久化目录。
# 如需重置对应目录，请确认数据无需保留，再显式设为 true；脚本会直接删除目录内容。
# export RESET_OPENCLAW_CONFIG='false'
# export RESET_AGFS_DATA='false'
# export RESET_OPENGAUSS_DATA='false'

# 记忆提取的待处理 token 阈值，必须是正整数。短对话演示可设为 1。
export OGMEM_AFTER_TURN_THRESHOLD='400'
