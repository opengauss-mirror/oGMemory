# ============================================================
# OpenClaw + oGMemory 部署配置（docker compose 路径）
# ============================================================
#
# ⚠️  DO NOT USE THESE DEFAULTS IN PRODUCTION ⚠️
# This file ships with placeholder passwords (CHANGE_ME_*) that fail the
# required-by-default check (`password is required — set it in deploy/.env`).
# Before running `docker compose up -d`, copy this file to `.env` and
# replace every `CHANGE_ME_*` placeholder with real values.
#
# 本文件是 docker compose 部署的单一配置源；deploy.sh (legacy docker run)
# 也读取同一份 .env（兜底读取 deploy.env 仅为向后兼容）。
#
# 架构：
# - openGauss（容器，profile: with-db）— 向量库
# - postgres（容器，profile: with-db）— oGMemory 的 SQL 存储后端
# - ogmem（容器）— 记忆服务 HTTP API（默认从源码构建）
# - openclaw（容器，profile: with-openclaw，可选）— Web 网关
#
# 使用：
#   cp .env.example .env
#   编辑 .env 填入必填项（见下文）
#   cp ogmemory.example.yaml ogmemory.yaml
#   docker compose --profile with-db up -d
#
# 标记 [必填] 的项必须设置；[可选] 项有合理默认值。
# 数据库变量按角色命名（STORAGE_DB_* / VECTOR_DB_*），从旧 OG_* /
# POSTGRES_* / OPENGAUSS_* 命名迁移时请对照第三部分的映射说明。
# ============================================================


# ============================================================
# 第一部分：OpenClaw Gateway + 共享 LLM 配置
# ============================================================
# 用于 OpenClaw Gateway 服务（openclaw 容器）
# 同时作为 oGMemory 的默认 LLM 配置（通过 ogmemory.yaml 中的 ${...} 引用）
# 参考：docker/entrypoint-openclaw.sh, ogmemory.example.yaml

# [必填] 选择一个和其他用户不冲突的子网，以使用docker compose构建容器
# 可选值： 172.81.0.0/16, 172.94.0.0/16 等
NETWORK_SUBNET=172.80.0.0/16

# [必填] 选择一个和其他用户不冲突的MCP_PORT
# 可选值： 1001-65535的任意空闲端口号
OGMEM_MCP_PORT=8091

# [必填] LLM 提供商标识
# 可选值：dashscope, openai, zhipu, volcengine 等
LLM_PROVIDER=openai

# [必填] LLM API 密钥
# 此值同时供 oG-Memory 使用（ogmemory.yaml 中 ${LLM_API_KEY}）
# 如果 oG-Memory 需要不同的 API Key，请在 ogmemory.yaml 中硬编码
LLM_API_KEY=your-llm-api-key

# [必填] LLM API 基础地址
# 此值同时供 oGMemory 使用（ogmemory.yaml 中 ${LLM_BASE_URL}）
# 示例：
#   - 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 火山引擎：https://ark.cn-beijing.volces.com/api/v3
#   - OpenAI：https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# [必填] LLM 模型名称
# 此值同时供 oGMemory 使用（ogmemory.yaml 中 ${LLM_MODEL}）
# 如果 oG-Memory 需要不同的模型，请在 ogmemory.yaml 中硬编码
# 示例：qwen3-max, glm-5, doubao-seed-2-0-code-preview-260215, gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# [可选] OpenClaw Gateway 端口
# 默认值：18789
# ⚠️ 必须是**整数**（不要加引号、不要带单位）。entrypoint 会把这个值
# 替换进 openclaw 配置 JSON 的 `gateway.port` 字段——加了引号会让 schema
# 校验失败（expected number, received string），容器会 crash loop。
#GATEWAY_PORT=18789

# [可选] OpenClaw Gateway Token（前端配对密码）
# 首次访问 Web 界面时需要输入此 Token
# 默认值：ogmem-default-token
#OPENCLAW_GATEWAY_TOKEN=ogmem-default-token

# [可选] OpenClaw 绑定模式
# 可选值：lan（局域网）, localhost（仅本机）
# 默认值：lan
#OPENCLAW_BIND_MODE=lan

# [可选] oGMemory HTTP API 地址
# OpenClaw 通过此地址连接到 ogmemory 服务
# 默认值：http://ogmem:8090（compose 服务名，可被 openclaw 容器解析）
# 如需走 host loopback，请改成 http://127.0.0.1:8090
#OGMEM_URL=http://ogmem:8090

# [可选] OpenClaw 连接 oGMemory 的认证 API Key
# 启用多租认证后，OpenClaw 需要通过此 Key 访问 oGMemory
# 默认回退到 OG_ROOT_API_KEY（ROOT 权限，可访问所有账户数据）
# 也可设置为 Admin Key（限定账户权限），格式：account_id:key 中的 key 部分
# 例如：OG_AUTH_API_KEY=admin-key-for-a（仅访问 acct-company-a）
# 推荐在 .env 中显式配置，不再从 ogmemory.yaml 反向推导
# 默认值：与 OG_ROOT_API_KEY 相同
#OG_AUTH_API_KEY=root-secret-key-change-me

# [可选] OpenClaw 连接 oGMemory 的账户 ID
# 当 OG_AUTH_API_KEY 是 Admin Key 时，此值必须与 Key 绑定的账户一致
# 当 OG_AUTH_API_KEY 是 Root Key 时，此值决定默认操作的账户
# 推荐在 .env 中显式配置，不再从 ogmemory.yaml 反向推导
# 默认值：与 OG_ACCOUNT_ID 相同
#OG_AUTH_ACCOUNT_ID=acct-demo

# [可选] OpenClaw 默认认证回退值
# 当未显式配置 OG_AUTH_API_KEY / OG_AUTH_ACCOUNT_ID 时，
# 单实例模式会分别回退到 OG_ROOT_API_KEY / OG_ACCOUNT_ID
# 推荐在启用多租认证时在这里统一配置，供 OpenClaw 和 ogmemory.yaml 共同复用
#OG_ROOT_API_KEY=root-secret-key-change-me
#OG_ACCOUNT_ID=acct-demo
#OG_USER_ID=u-alice
#OG_AGENT_ID=main

# [可选] oGMemory 多租管理员 Key 列表
# 仅 oGMemory 使用，OpenClaw 不直接读取此值
# 多个 key 用逗号分隔，格式示例：
#   acct-company-a:admin-key-for-a,acct-company-b:admin-key-for-b
#OG_ADMIN_API_KEYS=


# ============================================================
# 第二部分：oGMemory 服务配置
# ============================================================

# [可选] oGMemory 存储后端
# sql  — 使用postgres数据库存储 context/event
# 默认值：sql
#OGMEM_FS_BACKEND=sql

# ---- HTTP 服务 ----

# [可选] oGMemory HTTP 端口（容器内 = 宿主机）
# 默认值：8090
#OGMEM_HTTP_PORT=8090

# [可选] gunicorn worker 数
# 默认值：2
#OGMEM_WORKERS=2

# [可选] gunicorn 单请求超时（秒）
# 默认值：900
#OGMEM_GUNICORN_TIMEOUT=900

# ---- 索引服务 ----

# [可选] 索引间隔（秒）
# 默认值：15
#INDEX_INTERVAL=15

# [可选] 索引 worker 数
# 默认值：1
#INDEX_WORKERS=1

# ---- 身份 / 多租户 ----

# [可选] 默认账户 ID
# 默认值：acct-demo
#OG_ACCOUNT_ID=acct-demo

# [可选] 默认用户 ID
#OG_USER_ID=u-alice

# [可选] 默认 agent ID
#OG_AGENT_ID=main

# [可选] 是否启用多租认证
# 与 ogmemory.yaml 中 auth.role_control_enabled 同步设置
# 默认值：false
#OG_ROLE_CONTROL_ENABLED=false

# [可选] ROOT API Key（多租认证启用时必填）
#OG_ROOT_API_KEY=root-secret-key-change-me

# [可选] Admin API Key 列表（多租认证启用时使用）
#OG_ADMIN_API_KEYS=

# ---- Agent 共享 ----

# [可选] Agent 共享模式：off / list / all
# 默认值：off
#OG_AGENT_SHARED_MODE=off

# [可选] Agent 共享列表（mode=list 时使用）
#OG_AGENT_SHARED_LIST=

# ---- HTTP 访问控制 ----

# [可选] HTTP IP 白名单（逗号分隔），空表示禁用
#OG_HTTP_IP_ALLOWLIST=

# [可选] 是否信任 X-Forwarded-For（仅在可信代理后启用）
# 默认值：false
#OG_HTTP_IP_ALLOWLIST_TRUST_PROXY=false

# [可选] 可信代理 IP/CIDR 列表
#OG_HTTP_TRUSTED_PROXIES=

# ---- 记忆提取 ----

# [可选] 触发记忆提取的累计 token 阈值
# 默认值：200
#OGMEM_AFTER_TURN_THRESHOLD=200


# ============================================================
# 第三部分：数据库连接配置（STORAGE_DB_* / VECTOR_DB_* 两套）
# ============================================================
# 数据库相关的环境变量只有两套命名，按"角色"而非"产品"命名：
#   STORAGE_DB_*  — SQL 存储库（Postgres，context files / events / grants /
#                   outbox / M3 graph store 等业务数据）
#   VECTOR_DB_*   — 向量库（生产推荐 openGauss；dev / 单库部署可直接用
#                   同一个 pgvector Postgres——改 VECTOR_DB_HOST 即可切换）
# 旧命名 OG_* / POSTGRES_* / OPENGAUSS_* 已废弃。只有容器镜像自身要求的
# 变量（postgres 镜像的 POSTGRES_PASSWORD、openGauss 镜像的 GS_*）在
# docker-compose.yml 内部映射，.env 里不再出现。
#
# 两套变量可以是两个独立数据库（默认拓扑），也可以指向同一个实例
# （单库部署）：把 VECTOR_DB_HOST/PORT/NAME/USER 指向 STORAGE_DB_* 的
# 值即可，ogmemory.yaml 里 vector_db.connection_string 的 ${...} 引用
# 会自动跟随。

# ---- VECTOR_DB_*（向量库，openGauss 或 PG+pgvector） ----

# [必填] 向量库超级用户密码
# openGauss 密码要求（Postgres 不强制，但建议同样强度）：
#   - 长度至少 8 个字符
#   - 包含大写字母、小写字母、数字、特殊符号(#?!@$%^&*)中的至少三种
# ⚠️ 替换为生产密码。默认占位符会导致 `docker compose up` 报错退出。
VECTOR_DB_PASSWORD=CHANGE_ME_VECTOR_DB_PASSWORD

# [必填，仅 deploy.sh 路径] 向量库宿主机可达地址
# deploy.sh 用 host 网络模式，容器通过这个地址访问向量库（填宿主机 IP 或 127.0.0.1）。
# compose 路径下默认指向 compose 服务名 opengauss（见 docker-compose.yml）。
# 单库部署改为 postgres 即可与存储共用一个 Postgres。
VECTOR_DB_HOST=127.0.0.1

# [可选] 向量库容器内端口（仅 openGauss 镜像使用）
# 默认值：5432
# 这是 openGauss 容器**内部**监听的端口（compose 把它转写到
# VECTOR_DB_HOST_PORT——见下）。VECTOR_DB_PORT 不被 ogmem 进程读取；
# ogmem 看到的是 VECTOR_DB_HOST_PORT（与 STORAGE_DB_HOST_PORT 对齐）。
#VECTOR_DB_PORT=5432

# [可选] 向量库宿主机端口（默认 5432；与 STORAGE_DB 同端口会冲突，请改）
# 这是宿主机上 ogmem 拨号时实际命中的端口——compose 把这个端口转发到
# VECTOR_DB_PORT（容器内端口）。ogmem 跑在 host 网络命名空间里，只能
# 通过 127.0.0.1:<这个端口> 到达 bridge 桥接的 opengauss 容器。
# 命名与 STORAGE_DB_HOST_PORT 对齐。
#VECTOR_DB_HOST_PORT=5432

# [可选] 向量库用户名
# 默认值：gaussdb
#VECTOR_DB_USER=gaussdb

# [可选] 向量库数据库名
# 默认值：postgres
#VECTOR_DB_NAME=postgres

# [可选] 向量库容器名称
# 默认值：opengauss
#VECTOR_DB_CONTAINER_NAME=opengauss

# [可选] 向量库节点名称（仅 openGauss 镜像使用）
# 默认值：gaussdb
#VECTOR_DB_NODE_NAME=gaussdb

# [可选] openGauss 完整镜像引用（覆盖下方 OG_IMAGE_REPO/OG_IMAGE_TAG）
# 默认值：swr.cn-north-4.myhuaweicloud.com/kunpeng-ai/opengauss-distributed:0328
#OG_IMAGE=swr.cn-north-4.myhuaweicloud.com/kunpeng-ai/opengauss-distributed:0328

# [可选] openGauss 镜像仓库
# 默认值：swr.cn-north-4.myhuaweicloud.com/kunpeng-ai/opengauss-distributed
#OG_IMAGE_REPO=swr.cn-north-4.myhuaweicloud.com/kunpeng-ai/opengauss-distributed

# [可选] openGauss 镜像标签
# 默认值：0328
#OG_IMAGE_TAG=0328

# [可选] 向量库 CPU 亲和性（绑定到特定 CPU 核心，仅 openGauss 镜像使用）
# 示例：0-3 表示使用 CPU 0-3
# 默认值：无
#OG_CPUSET_CPUS=

# [可选] 向量库启动超时时间（秒，仅 deploy.sh 使用）
# 默认值：120
#OG_WAIT_TIMEOUT=120


# ---- STORAGE_DB_*（SQL 存储库，Postgres） ----

# [必填，启用 with-db profile 时] 存储库超级用户密码
# 建议 ≥8 字符（Postgres 不强制复杂度）
# ⚠️ 替换为生产密码。默认占位符会导致 `docker compose up` 报错退出。
STORAGE_DB_PASSWORD=CHANGE_ME_STORAGE_DB_PASSWORD

# [可选] 存储库用户名（默认 ogmem）
#STORAGE_DB_USER=ogmem

# [可选] 存储库数据库名（默认 ogmem）
#STORAGE_DB_NAME=ogmem

# [可选] 存储库宿主机端口（默认 5432；与 VECTOR_DB 同端口会冲突，请改）
# 命名/语义与 VECTOR_DB_HOST_PORT 对齐：这是宿主机上 ogmem 拨号时
# 实际命中的端口——compose 把这个端口转发到 postgres 容器内的 5432。
# ogmem 跑在 host 网络命名空间里，只能通过 127.0.0.1:<这个端口>
# 到达 bridge 桥接的 postgres 容器。
#STORAGE_DB_HOST_PORT=54321

# [可选] ogmem 看到的存储库主机
# 默认 127.0.0.1，对齐 VECTOR_DB_HOST：ogmem 跑在 host 网络命名空间，
# 只能通过宿主机 loopback 访问 bridge 桥接的 postgres 容器。
# 指向外部 DB 时改成 DB 的真实 IP 或 DNS 名。
#STORAGE_DB_HOST=127.0.0.1

# [可选] 存储库容器名称
# 默认值：ogmem-postgres
#STORAGE_DB_CONTAINER_NAME=ogmem-postgres



# ============================================================
# 第四部分：容器配置
# ============================================================

# [可选] OpenClaw 宿主机 IP（deploy.sh 使用，compose 忽略）
# 用于显示访问地址，建议填写宿主机实际 IP（而非 127.0.0.1）
# 默认值：127.0.0.1
#OPENCLAW_HOST_IP=127.0.0.1

# ---- ogmemory 容器配置 ----

# [可选] ogmemory 容器名称
# 默认值：ogmem
#OGMEM_CONTAINER_NAME=ogmem

# [可选] ogmemory 镜像
# 默认值：从本地源码构建，tag 为 ogmemory:<compose-project>-local，避免不同项目覆盖镜像
# 如需使用预构建镜像，设置 OGMEM_IMAGE=...，然后显式 pull 并使用 up --no-build
#OGMEM_IMAGE=ogmemory:my-project-local

# ---- openclaw-ogmemory 容器配置 ----

# [可选] openclaw-ogmemory 容器名称
# 默认值：openclaw_ogmem
#OPENCLAW_CONTAINER_NAME=openclaw_ogmem

# [可选] openclaw-ogmemory 镜像
# 默认值：从本地源码构建，tag 为 openclaw-ogmemory:<compose-project>-local
# 如需使用预构建镜像，设置 OPENCLAW_IMAGE=...，然后显式 pull 并使用 up --no-build
#OPENCLAW_IMAGE=openclaw-ogmemory:my-project-local

# [可选] OpenClaw 状态持久化目录
# 设置后会挂载到容器的 /home/node/.openclaw
# 默认值：无（不挂载；推荐设置以避免重复配对）
# 注意：openclaw.json 由容器入口脚本托管。升级时如检测到缺少关键字段，
# 会先备份旧文件再按当前模板重建。
#OPENCLAW_HOME_DIR=/home/you/ogmem/openclaw-data
# Automatic Q/A capture and memory recall (applied at container startup).
# Recreate openclaw after changes. These are not a global memory write ban.
OGMEM_AUTO_CAPTURE=false
OGMEM_AUTO_RECALL=true
# Optional fallback identity if the gateway host omits lifecycle identity.
# For a clean experiment also choose a fresh OPENCLAW_HOME_DIR, and align
# ogmemory.yaml identity.account_id/user_id/agent_id for direct API requests.
OGMEM_ACCOUNT_ID=
OGMEM_USER_ID=
OGMEM_AGENT_ID=
# Explicitly register gateway agents used by X-OpenClaw-Agent-ID requests.
# A fresh gateway knows only "main"; OGMEM_AGENT_ID does not register agents.
OPENCLAW_AGENT_IDS=

# Multi-tenant shortcut for shared oGMemory + multiple OpenClaw gateways.
# 仅 deploy.sh 支持；compose 路径下需要在 docker-compose.yml 中显式声明每个实例。
# 格式：
# OPENCLAW_INSTANCES="container_name|gateway_port|gateway_token|auth_api_key|auth_account_id|openclaw_home_dir;..."
#OPENCLAW_INSTANCES=


# ============================================================
# 第五部分：部署控制参数
# ============================================================

# [可选] 是否自动执行健康检查（仅 deploy.sh）
# 默认值：true
#AUTO_HEALTH_CHECK=true

# [可选] 是否跳过镜像拉取（仅 deploy.sh）
# 默认值：false
#SKIP_PULL=false


# ============================================================
# 第六部分：性能监控（perf）
# ============================================================
# perf 模块记录每个请求的耗时、Token 消耗和美元成本，写入 JSONL 日志文件。
# 详见 perf/README.md。
#
# 启用后，OgMemConfig.load() 会将这些值导出为 OGMEM_PERF_* 环境变量，
# 触发 perf.get_recorder() 自动启用。
#
# 多 worker 说明：
#   gunicorn 每个 worker 进程有独立的 Token 计数器，perf 日志会写入多个文件。
#   启用 perf 时建议设置 OGMEM_WORKERS=1，所有日志写入同一文件，
#   便于 `python -m perf.report` 直接生成报告。
#
# 报告生成：
#   python -m perf.report <宿主机日志路径>/perf.jsonl -o report.md
#
# ============================================================

# [可选] 是否启用 perf 性能监控
# 默认值：不启用
#OGMEM_PERF_ENABLED=1

# [可选] perf 日志输出路径（容器内绝对路径）
# 需要同步挂载宿主机目录，否则容器销毁后日志丢失
# 示例：-v /home/user/ogmem/perf_logs:/opt/ogmem/perf_logs
# 默认值：/opt/ogmem/perf_logs/<run_id>.jsonl（每 worker 独立文件）
#OGMEM_PERF_OUT=/opt/ogmem/perf_logs/perf.jsonl

# [可选] perf 日志 HTTP 推送地址
# 设置后每条 SpanEvent 实时 POST 到此地址（可与 OGMEM_PERF_OUT 同时使用）
# 默认值：不推送
#OGMEM_PERF_HTTP_URL=

# [可选] perf run_id 标识（区分不同部署批次）
# 默认值：自动生成 UUID
#OGMEM_PERF_RUN_ID=

# [可选] perf 日志宿主机挂载目录
# 设置后会把该目录挂载到容器的 /opt/ogmem/perf_logs，
# 容器销毁后日志保留在宿主机。同时需设置 OGMEM_PERF_OUT。
# 默认值：deploy/_artifacts/perf
#PERF_LOGS_HOST_DIR=/home/you/ogmem/perf_logs

# Optional Compose face detection (CPU InsightFace with face embeddings).
# Configure cv_service in ogmemory.yaml for bundled or external services.
# Export OGMEM_CV_SERVICE_URL to override the YAML in a host-side M3 run.
# Compose .env values are not automatically exported to host processes.
#OGMEM_CV_PORT=8081
#OGMEM_CV_BIND_HOST=127.0.0.1
#OGMEM_CV_IMAGE=ogmemory-cv:local
#OGMEM_CV_SERVICE_URL=http://127.0.0.1:8081
#OGMEM_CV_AUTH_TOKEN=

# Default skips Go/AGFS; requires SQL storage or an externally managed AGFS server.
# Set standalone-agfs explicitly to build and bundle the local AGFS server.
OGMEM_BUILD_TARGET=standalone-no-agfs
