# ============================================================
# Parallel LoCoMo run — env template (rychkov stack)
# Committed reference for every deploy/.env knob the 32-way
# parallel ingest/QA runs depend on. Copy the relevant lines
# into your deploy/.env (which is gitignored). Secrets are
# placeholders — never commit real keys.
#
# Full narrative: docs/locomo_parallel_runbook.md
# Enforcement:    scripts/check_locomo_parallel.py --phase ingest|qa
# ============================================================

# ---- compose identity (must be unique per user on a shared host) ----
COMPOSE_PROJECT_NAME=ogmem-rychkov
NETWORK_SUBNET=172.81.0.0/16
OGMEM_MCP_PORT=18091

# ---- LLM (OpenAI-compatible endpoint) ----
# Reasoning models (deepseek-v4.1-flash) need llm.max_tokens >= 32768 in
# ogmemory.yaml or extraction dies with finish_reason=length.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.modelarts-maas.com/v2
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=<your-key>

# ---- oGMemory HTTP ----
OGMEM_HTTP_PORT=18090
OGMEM_CONTAINER_NAME=rychkov-ogmem
# CRITICAL for 32-way load: the 900s default kills long composes mid-request.
OGMEM_GUNICORN_TIMEOUT=3600

# ---- OpenClaw gateway ----
GATEWAY_PORT=18979
OPENCLAW_GATEWAY_TOKEN=<your-token>
OPENCLAW_CONTAINER_NAME=rychkov-openclaw-ogmem
OPENCLAW_BIND_MODE=lan
OPENCLAW_HOME_DIR=./_rychkov/openclaw-home

# CRITICAL, PHASE-DEPENDENT:
#   ingest: true  (after_turn extraction — without it ingest stalls silently)
#   qa:     false (eager re-capture of 60-120k-token recall injections blocks
#            every QA turn in 503-retry loops)
# After flipping, RECREATE the containers (docker compose up -d) — a plain
# restart does not update container environment.
OGMEM_AUTO_CAPTURE=false
OGMEM_AUTO_RECALL=true

# The gateway does NOT forward the /v1/responses "user" field to the
# context-engine plugin — pin the ogmem identity here, matching the
# locomo-test config's user so ingest and QA share one namespace.
OGMEM_ACCOUNT_ID=acct-rychkov
OGMEM_USER_ID=rychkov-small
OGMEM_AGENT_ID=main

# ---- Postgres (single-DB: storage AND vector via pgvector) ----
STORAGE_DB_CONTAINER_NAME=rychkov-ogmem-postgres
STORAGE_DB_HOST=127.0.0.1
STORAGE_DB_HOST_PORT=15432
STORAGE_DB_USER=ogmem
STORAGE_DB_NAME=ogmem
STORAGE_DB_PASSWORD=<your-password>
# Single-DB mode: VECTOR_DB_* points at the SAME postgres as STORAGE_DB_*
VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_HOST_PORT=15432
VECTOR_DB_USER=ogmem
VECTOR_DB_NAME=ogmem
VECTOR_DB_PASSWORD=<your-password>

# ---- Embedder (dedicated instance — see runbook §1) ----
# The shared :8000 service serializes all requests on one CPU process and
# causes APITimeoutError retry storms under 32-way load. Run a private
# container. base_url in ogmemory.yaml must include /v1 and
# vector_db.dimension must equal the model's output dims (1024 here).
M3_EMBED_API_KEY=<embedder-bearer>

# ---- NOT settable via env (manual, live-config only) ----
# agents.defaults.maxConcurrent: 32  in the live openclaw.json
#   (deploy/_rychkov/openclaw-home/openclaw.json, uid-1000 mode 600 — edit
#   via docker exec). There is NO env knob; the entrypoint regenerates the
#   file from env on start and manual edits have been observed lost after
#   restarts. Re-apply after any gateway reset; the preflight script checks
#   the live file and fails if it's missing.
#
# service.threads: 32  and  llm.max_tokens: 32768  in deploy/ogmemory.yaml
#   (gitignored — deploy/ogmemory.example.yaml is the committed base).
