# ════════════════════════════════════════════════════════════
# ContextEngine .gitignore
# ════════════════════════════════════════════════════════════

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!cli/lib/
!plugins/deepseek-harness/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/

# ── Windows ───────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ─────────────────────────────────────────────────────
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── 日志 & 临时文件 ───────────────────────────────────────────
*.log

# ── 环境变量 & 密钥（绝不提交）───────────────────────────────
.env
.env.*
!.env.example
!config/env.example
!deploy/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Generated Agent connection exports (may contain service credentials)
/ogmem-client-config/

# Config
config.json
config/ogmem.yaml
*.toml
!pyproject.toml

# ── Claude Code 运行时文件（本地开发配置，不纳入版本控制）──────
.claude/

# ── Claude Team 协调文件（团队内部通信，非项目代码）────────────
.claude-team/
team/

# ── 向量索引本地数据（开发时的本地索引，不纳入版本控制）──────
*.faiss
*.index
*.bin
local_index/
vector_store/

# ── localfs AGFS 工作目录（开发时的本地节点数据）─────────────
data/
workspace/
accounts/

# ── Jupyter（如有探索性 notebook）───────────────────────────
.ipynb_checkpoints/
*.ipynb
profile_default/
ipython_config.py

# ── OpenClaw Plugin ─────────────────────────────────────────────
plugins/openclaw/node_modules/
plugins/openclaw/package-lock.json
plugins/deepseek-harness/node_modules/

# AGFS 测试数据（不纳入版本控制）
.agfs_data/

# AGFS built binary
agfs/agfs-server

# Environment variables (DO NOT COMMIT)
.env
.env.local

# ── Runtime / eval artifacts ───────────────────────────────────
.agfs_pid
.ce_pid
.chroma_data/
chroma_db/
.venv/
.venv-deepagents/
.DS_Store
*.DS_Store
.omc/
.ingest_record.json
config/ogmem.yaml
*.bak

# ── Local dev config & IDE ────────────────────────────────────
CLAUDE.md
*.code-workspace
.cursor/

# ── Runtime data (chroma, agfs localfs, etc.) ────────────────
.ogmem_data/

# ── Perf runtime artifacts (local testing output) ────────────
perf_logs/
perf_output/

# ── Deploy runtime (local working copies with secrets/absolute paths) ──
ogmem-deploy/
deploy/ogmemory.yaml

# ── Generated reports (not source code) ────────────────────────
PLUGIN_PRODUCTION_READINESS_REPORT.md
coverage.json

# ── Test/eval runtime artifacts ─────────────────────────────────
tests/e2e/.ingest_record.json
tests/e2e/ingest_output*
tests/e2e/qa_output*
tests/e2e/qa_results*
tests/e2e/qa_results/
tests/e2e/results*.csv
tests/e2e/results/

# Eval output
tests/e2e/api_logs/
tests/e2e/result/

# ── PRD documents (local design artifacts) ─────────────────────
docs/prd/

# Local git worktrees
.worktrees/

# Local verification artifacts
.tmp/
opencode-verification/

# Root-level config & external repos (never commit)
/ogmem.yaml
/locomo-eval-kit/

# pre-commit 本地隔离环境（由 setup-pre-commit.sh 创建，不提交）
.pre-commit-venv/

# Private backups written by local onboarding
/config/ogmem.yaml.bak-*

# Persistent advisory lock inodes for deployment management
.ogmemory-*.lock

deploy/ogmemory.yaml
# legacy, kept ignored for users who still have it
deploy/deploy.env

# docker-compose local artifacts
deploy/.env
deploy/docker-compose.override.yml
deploy/docker-compose.tenants.yml
deploy/_artifacts/

# Asciinema recordings (local demo artifacts, not source)
*.cast
*.gif

# SWE-bench local configuration, caches, credentials and generated results
/benchmarks/swebench/work/
/benchmarks/swebench/config.yaml
